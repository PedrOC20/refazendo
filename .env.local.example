# Resend API key — copia de resend.com → API Keys → Create.
# Server-only. Nunca prefixar com NEXT_PUBLIC_ (caso contrário fica exposta ao browser).
RESEND_API_KEY=

# Destinatário dos pedidos do formulário (opcional).
# Default no código: refazendo.mail@gmail.com
# CONTACT_DESTINATION_EMAIL=refazendo.mail@gmail.com
